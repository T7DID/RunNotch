{
  "name": "runnotch",
  "version": "0.2.0",
  "description": "Your long-running commands, one glance away.",
  "private": true,
  "license": "MIT",
  "author": "RunNotch contributors",
  "main": "src/main.cjs",
  "type": "commonjs",
  "bin": {
    "runnotch": "cli/runnotch.mjs"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "node scripts/launch.mjs --dev",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.mjs",
    "pack:win": "electron-builder --win portable",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.runnotch.desktop",
    "productName": "RunNotch",
    "asar": true,
    "files": [
      "src/**/*",
      "cli/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "packaging/runnotch.cmd",
        "to": "runnotch.cmd"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/runnotch-mark.svg",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "RunNotch-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "RunNotch-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
